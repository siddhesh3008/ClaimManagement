  "components": {
    "schemas": {
      "CreateAssessmentDto": {
        "type": "object",
        "properties": {
          "assessedAmount": {
            "maximum": 999999999999999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "deductible": {
            "maximum": 999999999999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "depreciation": {
            "maximum": 999999999999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "nonPayable": {
            "maximum": 999999999999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "netPayable": {
            "maximum": 999999999999999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateClaimDocumentDto": {
        "required": [
          "documentName"
        ],
        "type": "object",
        "properties": {
          "documentName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "filePath": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateClaimDto": {
        "required": [
          "claimType"
        ],
        "type": "object",
        "properties": {
          "policyId": {
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "customerId": {
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "claimType": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "incidentDate": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedLoss": {
            "maximum": 999999999999999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateInvestigationDto": {
        "required": [
          "investigationReason"
        ],
        "type": "object",
        "properties": {
          "investigatorId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "investigationReason": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateSurveyDto": {
        "type": "object",
        "properties": {
          "surveyorId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "inspectionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "InvestigationReportDto": {
        "required": [
          "reportPath"
        ],
        "type": "object",
        "properties": {
          "reportPath": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SettlementDTO": {
        "required": [
          "paymentMode"
        ],
        "type": "object",
        "properties": {
          "paymentMode": {
            "minLength": 1,
            "pattern": "^(NEFT|RTGS|IMPS|UPI|Cheque)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SurveyReportDto": {
        "required": [
          "remarks"
        ],
        "type": "object",
        "properties": {
          "inspectionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "reportPath": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "remarks": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateClaimDto": {
        "required": [
          "claimType"
        ],
        "type": "object",
        "properties": {
          "claimType": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "incidentDate": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedLoss": {
            "maximum": 999999999999999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
